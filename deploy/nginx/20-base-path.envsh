#!/bin/sh

set -eu

AUSE_PUBLIC_BASE_PATH="${AUSE_PUBLIC_BASE_PATH:-/ause-discovery/}"
AUSE_PUBLIC_BASE_PATH_NO_TRAILING="${AUSE_PUBLIC_BASE_PATH%/}"

if [ -z "${AUSE_PUBLIC_BASE_PATH_NO_TRAILING}" ]; then
  AUSE_PUBLIC_BASE_PATH_NO_TRAILING="/__root-no-redirect__"
fi

export AUSE_PUBLIC_BASE_PATH
export AUSE_PUBLIC_BASE_PATH_NO_TRAILING
