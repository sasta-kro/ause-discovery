map $http_x_forwarded_proto $ause_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

server {
    listen 8080;
    server_name _;
    client_max_body_size 250m;
    absolute_redirect off;

    include /etc/nginx/security-headers.conf;

    location = ${AUSE_PUBLIC_BASE_PATH_NO_TRAILING} {
        return 308 ${AUSE_PUBLIC_BASE_PATH};
    }

    location ${AUSE_PUBLIC_BASE_PATH}api/v1/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ause_forwarded_proto;
    }

    location ${AUSE_PUBLIC_BASE_PATH}health/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ause_forwarded_proto;
    }

    location ${AUSE_PUBLIC_BASE_PATH}assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
    }

    location ${AUSE_PUBLIC_BASE_PATH} {
        root /usr/share/nginx/html;
        try_files $uri $uri/ ${AUSE_PUBLIC_BASE_PATH}index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }
}
