# AUSE Discovery environment
#
# Copy this file, fill in the secrets marked below, and pass it explicitly:
#   docker compose --env-file <your-file> up
# Every value shown is the working development default. Production
# requirements are listed at the bottom.

# ---- Application core ------------------------------------------------------

# development | test | production
AUSE_ENV=development
AUSE_LISTEN_ADDR=:8080
# Public path the application is served under. Root deployment uses /
AUSE_PUBLIC_BASE_PATH=/ause-discovery/
AUSE_LOG_LEVEL=info

# ---- PostgreSQL (canonical data) -------------------------------------------

AUSE_DATABASE_URL=postgres://ause:ause@postgres:5432/ause_discovery?sslmode=disable

# ---- Meilisearch (derived search index, fully rebuildable) ------------------

AUSE_MEILISEARCH_URL=http://meilisearch:7700
AUSE_MEILISEARCH_API_KEY=local-development-key-change-before-production
AUSE_MEILISEARCH_INDEX=projects

# ---- Artifact storage (AD-011: pluggable backend) ---------------------------
#
# local = Artifact bytes are files under AUSE_ARTIFACT_ROOT below
# b2    = Artifact bytes live in a private Backblaze B2 bucket through its
#         S3-compatible API. The API proxies every read, visitors never
#         contact the bucket.
AUSE_ARTIFACT_STORAGE_BACKEND=local

# Filesystem root for the local backend. Still required when the backend is
# b2: it is the migration source and the rollback second-copy location.
AUSE_ARTIFACT_ROOT=/var/lib/ause-discovery/artifacts

# B2 values must be set together and are required when the backend is b2.
# The application key is the only secret among the four.
AUSE_ARTIFACT_B2_ENDPOINT=s3.us-west-004.backblazeb2.com
AUSE_ARTIFACT_B2_BUCKET=ause-discovery-artifacts
AUSE_ARTIFACT_B2_KEY_ID=0045df50d3a37e70000000001
AUSE_ARTIFACT_B2_APPLICATION_KEY=

# ---- Upload limits ----------------------------------------------------------

# 250 MiB per Artifact file, 2 GiB active bytes per Project
AUSE_MAX_ARTIFACT_BYTES=262144000
AUSE_MAX_PROJECT_ARTIFACT_BYTES=2147483648
# Temporary storage for import preview files
AUSE_IMPORT_TEMP_ROOT=/var/lib/ause-discovery/imports

# ---- Sessions ---------------------------------------------------------------

AUSE_SESSION_IDLE_TTL=30m
AUSE_SESSION_ABSOLUTE_TTL=12h
AUSE_SESSION_SECRET=local-development-session-secret-change-before-production
AUSE_COOKIE_SECURE=false

# ---- Network trust ----------------------------------------------------------

# Comma-separated CIDR list of the reverse proxy in front of the API
AUSE_TRUSTED_PROXY_CIDRS=
AUSE_FEATURED_PROJECT_IDS=

# ---- Frontend build (compiled into the web image) ---------------------------

VITE_PUBLIC_BASE_PATH=/ause-discovery/
VITE_API_PATH=api/v1

# ---- Compose service settings -----------------------------------------------

POSTGRES_DB=ause_discovery
POSTGRES_USER=ause
POSTGRES_PASSWORD=ause
MEILI_ENV=development
MEILI_MASTER_KEY=local-development-key-change-before-production

# Local development keeps these defaults so Compose builds local images.
# Production sets complete image references, preferably immutable digests
# published by the tagged release workflow, for example:
#   ghcr.io/<owner>/<repository>-api@sha256:<digest>
# and starts with: docker compose pull && docker compose up -d --no-build
AUSE_API_IMAGE=ause-discovery-api:dev
AUSE_WEB_IMAGE=ause-discovery-web:dev

# Host port the web service is published on
AUSE_WEB_PORT=8088

# ---- Production requirements (see docs/operations/runbook.md) ---------------
#
# - AUSE_ENV=production and AUSE_COOKIE_SECURE=true are mandatory together.
# - POSTGRES_PASSWORD, AUSE_DATABASE_URL, AUSE_MEILISEARCH_API_KEY,
#   AUSE_SESSION_SECRET, MEILI_MASTER_KEY, and (when the backend is b2)
#   AUSE_ARTIFACT_B2_APPLICATION_KEY must carry unique strong values.
# - MEILI_ENV=production is recommended.
# - AUSE_TRUSTED_PROXY_CIDRS must list the reverse-proxy network range.
# - A non-default production base path requires a matching web image build
#   because VITE_PUBLIC_BASE_PATH is compiled into the web image.
