# Application runtime
AUSE_ENV=development
AUSE_LISTEN_ADDR=:8080
AUSE_PUBLIC_BASE_PATH=/ause-discovery/
AUSE_DATABASE_URL=postgres://ause:ause@postgres:5432/ause_discovery?sslmode=disable
AUSE_MEILISEARCH_URL=http://meilisearch:7700
AUSE_MEILISEARCH_API_KEY=local-development-key-change-before-production
AUSE_MEILISEARCH_INDEX=projects
AUSE_ARTIFACT_ROOT=/var/lib/ause-discovery/artifacts
AUSE_IMPORT_TEMP_ROOT=/var/lib/ause-discovery/imports
AUSE_MAX_ARTIFACT_BYTES=262144000
AUSE_MAX_PROJECT_ARTIFACT_BYTES=2147483648
AUSE_SESSION_IDLE_TTL=30m
AUSE_SESSION_ABSOLUTE_TTL=12h
AUSE_SESSION_SECRET=local-development-session-secret-change-before-production
AUSE_COOKIE_SECURE=false
AUSE_TRUSTED_PROXY_CIDRS=
AUSE_FEATURED_PROJECT_IDS=
AUSE_LOG_LEVEL=info

# Frontend build
VITE_PUBLIC_BASE_PATH=/ause-discovery/
VITE_API_PATH=api/v1

# Compose persistence
POSTGRES_DB=ause_discovery
POSTGRES_USER=ause
POSTGRES_PASSWORD=ause
MEILI_MASTER_KEY=local-development-key-change-before-production
