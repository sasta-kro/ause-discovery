# Application runtime
AUSE_ENV=development
AUSE_LISTEN_ADDR=:8080
AUSE_PUBLIC_BASE_PATH=/ause-discovery/
AUSE_DATABASE_URL=postgres://ause:ause@postgres:5432/ause_discovery?sslmode=disable
AUSE_MEILISEARCH_URL=http://meilisearch:7700
AUSE_MEILISEARCH_API_KEY=local-development-key-change-before-production
AUSE_MEILISEARCH_INDEX=projects
AUSE_ARTIFACT_ROOT=/var/lib/ause-discovery/artifacts
AUSE_IMPORT_TEMP_ROOT=/var/lib/ause-discovery/imports
AUSE_MAX_ARTIFACT_BYTES=262144000
AUSE_MAX_PROJECT_ARTIFACT_BYTES=2147483648
AUSE_SESSION_IDLE_TTL=30m
AUSE_SESSION_ABSOLUTE_TTL=12h
AUSE_SESSION_SECRET=local-development-session-secret-change-before-production
AUSE_COOKIE_SECURE=false
AUSE_TRUSTED_PROXY_CIDRS=
AUSE_FEATURED_PROJECT_IDS=
AUSE_LOG_LEVEL=info

# Frontend build
VITE_PUBLIC_BASE_PATH=/ause-discovery/
VITE_API_PATH=api/v1

# Compose persistence
POSTGRES_DB=ause_discovery
POSTGRES_USER=ause
POSTGRES_PASSWORD=ause
MEILI_ENV=development
MEILI_MASTER_KEY=local-development-key-change-before-production

# Compose application images
# Local development keeps these defaults so Compose builds the local images.
# Production sets complete image references, preferably immutable digests
# published by the tagged release workflow, for example:
#   ghcr.io/<owner>/<repository>-api@sha256:<digest>
# Start production with: docker compose pull && docker compose up -d --no-build
AUSE_API_IMAGE=ause-discovery-api:dev
AUSE_WEB_IMAGE=ause-discovery-web:dev

# Host port published by the web service
AUSE_WEB_PORT=8088

# Production requirements (see docs/operations/runbook.md):
# - AUSE_ENV=production and AUSE_COOKIE_SECURE=true are mandatory together.
# - POSTGRES_PASSWORD, AUSE_DATABASE_URL, AUSE_MEILISEARCH_API_KEY,
#   AUSE_SESSION_SECRET, and MEILI_MASTER_KEY must carry unique strong values.
# - MEILI_ENV=production is recommended for production operation.
# - AUSE_TRUSTED_PROXY_CIDRS must list the reverse-proxy network range.
# - A non-default production base path requires a matching web image build
#   because VITE_PUBLIC_BASE_PATH is compiled into the web image.
